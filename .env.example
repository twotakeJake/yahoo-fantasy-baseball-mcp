# Yahoo authentication — session cookies (NOT OAuth; see README → Authentication)
# Full `Cookie` header from an authenticated baseball.fantasysports.yahoo.com session.
YAHOO_COOKIES=your_full_cookie_header_string

# Optional — the server fetches and refreshes the crumb automatically.
YAHOO_CRUMB=

# Your fantasy league settings (league ID is in your Yahoo league URL)
YAHOO_LEAGUE_ID=your_league_id_here
YAHOO_TEAM_NUMBER=your_team_number_here
YAHOO_TEAM_NAME=your_team_name_here

# Deprecated — only the legacy OAuth helper scripts (npm run get-token / refresh-token)
# read these. The live server ignores them; Yahoo's OAuth tokens get 403 from the
# Fantasy Sports API. Left here for reference only.
# YAHOO_CLIENT_ID=your_yahoo_client_id_here
# YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
# YAHOO_ACCESS_TOKEN=your_access_token_here
# YAHOO_REFRESH_TOKEN=your_refresh_token_here
